{
  "name": "four-oh-four",
  "private": true,
  "version": "1.0.0",
  "description": "A puzzle-platformer played entirely inside your browser's address bar. Built for the BTT Web Game Jam - Summer 2026.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelfrancoodev/four-oh-four.git"
  },
  "homepage": "https://four-oh-four.vercel.app",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,html,md}\"",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
